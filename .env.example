# Newsletter (/api/subscribe) and field-guide (/api/field-guide) signups go to MailerLite.
# MailerLite authenticates every write with a secret token, so both run server-side and need
# the key below. The contact form (api/contact.js) still goes to Kit for now; that moves to
# Tide in a later phase.
# MAILERLITE_API_KEY is REQUIRED for the two signups; without it they are refused, not dropped.
# The two GROUP ids are OPTIONAL: set them to the MailerLite group ids for each source and
# signups get grouped; leave blank and signups still work, just ungrouped.
# MAILERLITE_API_URL is an OPTIONAL override of the subscribers endpoint.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_NEWSLETTER=
MAILERLITE_GROUP_ASSESSMENT=
MAILERLITE_API_URL=

# Field-guide email capture (/api/field-guide) also emails the guide link via Resend. The two
# below are OPTIONAL — if unset, the on-page instant PDF download and Buttondown's opt-in email
# still work; setting them also emails the guide link.
RESEND_API_KEY=
FIELD_GUIDE_FROM=Understory Collaborative <contact@understorycollab.com>
# Canonical site origin for absolute links in the guide email (falls back to request host).
SITE_URL=

# Contact notification (/api/contact — the never-miss floor). Every submission emails
# contact@understorycollab.com via Resend before Kit runs. It needs RESEND_API_KEY (above)
# plus a from address: CONTACT_NOTIFY_FROM if set, otherwise FIELD_GUIDE_FROM. Setting
# FIELD_GUIDE_FROM alone covers both features. The from domain must be verified in Resend.
CONTACT_NOTIFY_FROM=
