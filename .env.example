# Newsletter signups (/api/subscribe) go to MailerLite. MailerLite authenticates every write
# with a secret token, so the signup runs server-side and needs the key below.
# MAILERLITE_API_KEY is REQUIRED for the newsletter signup; without it signups are refused, not
# silently dropped. It is a secret, so it lives here / in Vercel, never in the repo.
# The group ids are NOT secret and live in code (api/subscribe.js, MAILERLITE_GROUPS), not here.
# MAILERLITE_API_URL is an OPTIONAL override of the subscribers endpoint.
MAILERLITE_API_KEY=
MAILERLITE_API_URL=

# Field guide (/api/field-guide) delivers the assessment guide with NO list write: the results
# screen reveals an instant PDF download, and if the two below are set, we also email the link.
# They are OPTIONAL — without them the instant on-page download still works.
RESEND_API_KEY=
FIELD_GUIDE_FROM=Understory Collaborative <contact@understorycollab.com>
# Canonical site origin for absolute links in the guide email (falls back to request host).
SITE_URL=

# Contact form (/api/contact) delivers each message as an email to contact@understorycollab.com
# via Resend, and adds the sender to NO list. Resend is REQUIRED here: without it the form reports
# an error instead of dropping the message. It needs RESEND_API_KEY (above) plus a from address:
# CONTACT_NOTIFY_FROM if set, otherwise FIELD_GUIDE_FROM. Setting FIELD_GUIDE_FROM alone covers
# both the guide and contact emails. The from domain must be verified in Resend.
CONTACT_NOTIFY_FROM=
