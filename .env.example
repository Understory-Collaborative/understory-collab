# Newsletter signups go to Kit (formerly ConvertKit) via the public form endpoint
# hardcoded in src/lib/kit.js. The form id is public, so there is nothing to set here.

# Ghost Admin API — used by the /api/unsubscribe serverless function (server-side only).
# Base site URL (no /ghost/api path); the function appends the admin path itself.
GHOST_ADMIN_API_URL=https://the-canopy.ghost.io
# Admin API key "{id}:{hexsecret}" from a Ghost Custom Integration
# (Settings → Advanced → Integrations → Add custom integration).
GHOST_ADMIN_API_KEY=your_admin_api_key_here

# Google Apps Script Web App URL that receives contact-form submissions and
# appends them to a Google Sheet. Set this in Vercel env for /api/contact to work.
# See the setup steps at the top of api/contact.js.
CONTACT_SHEET_WEBHOOK_URL=

# Field-guide email capture (/api/field-guide). Uses the GHOST_ADMIN_API_* vars above to
# add the subscriber (Ghost sends the double opt-in email). The two below are OPTIONAL —
# if unset, the on-page instant PDF download and Ghost's opt-in email still work; setting
# them also emails the guide link via Resend.
RESEND_API_KEY=
FIELD_GUIDE_FROM=Understory Collaborative <hello@understorycollab.com>
# Canonical site origin for absolute links in the guide email (falls back to request host).
SITE_URL=
