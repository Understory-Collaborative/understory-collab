# Newsletter and field-guide signups go to Kit (formerly ConvertKit) via the public form
# endpoint, hardcoded in src/lib/kit.js and api/field-guide.js. The form id is public, so
# there is no key here and nothing that requires a paid plan.

# Google Apps Script Web App URL that receives contact-form submissions and
# appends them to a Google Sheet. Set this in Vercel env for /api/contact to work.
# See the setup steps at the top of api/contact.js.
CONTACT_SHEET_WEBHOOK_URL=

# Field-guide email capture (/api/field-guide) subscribes via the Kit form above (Kit sends
# the double opt-in email). The two below are OPTIONAL — if unset, the on-page instant PDF
# download and Kit's opt-in email still work; setting them also emails the guide link via Resend.
RESEND_API_KEY=
FIELD_GUIDE_FROM=Understory Collaborative <hello@understorycollab.com>
# Canonical site origin for absolute links in the guide email (falls back to request host).
SITE_URL=
