# Newsletter, contact, and field-guide signups all go to Kit (formerly ConvertKit) via the
# public form endpoint, hardcoded in src/lib/kit.js, api/contact.js, and api/field-guide.js.
# The form id is public, so there is no key here and nothing that requires a paid plan.
# No Vercel env var is needed for the contact form.

# Field-guide email capture (/api/field-guide) subscribes via the Kit form above (Kit sends
# the double opt-in email). The two below are OPTIONAL — if unset, the on-page instant PDF
# download and Kit's opt-in email still work; setting them also emails the guide link via Resend.
RESEND_API_KEY=
FIELD_GUIDE_FROM=Understory Collaborative <hello@understorycollab.com>
# Canonical site origin for absolute links in the guide email (falls back to request host).
SITE_URL=

# Contact notification (/api/contact — the never-miss floor). Every submission emails
# contact@understorycollab.com via Resend before Kit runs. It needs RESEND_API_KEY (above)
# plus a from address: CONTACT_NOTIFY_FROM if set, otherwise FIELD_GUIDE_FROM. Setting
# FIELD_GUIDE_FROM alone covers both features. The from domain must be verified in Resend.
CONTACT_NOTIFY_FROM=
