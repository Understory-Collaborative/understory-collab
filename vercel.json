{
  "framework": "astro",
  "redirects": [
    {
      "source": "/advisory",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/implementation",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/values",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/portfolios",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/newsletter",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/newsletter/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/quiz",
      "destination": "/assessment",
      "permanent": true
    },
    {
      "source": "/apply",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
