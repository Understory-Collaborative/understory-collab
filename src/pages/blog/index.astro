---
// The blog index. Lists published posts newest first. When there are none yet it
// shows a plain empty state rather than a broken-looking blank page.
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPublishedPosts } from '../../lib/blog.js'
import { formatDate } from '../../lib/frontmatter.js'
import { findAuthor } from '../../data/authors'
import '../../views/Blog.css'

const posts = await getPublishedPosts()
---
<BaseLayout
  title="Blog"
  description="Field notes on technical product management from Understory Collaborative: scope, delivery, and keeping technical work healthy."
>
  <div class="blog">
    <section class="page-hero" aria-labelledby="blog-heading">
      <div class="page-hero-content">
        <h1 id="blog-heading">Blog</h1>
        <p class="page-hero-description">
          Field notes on technical product management: scope, delivery, and keeping
          technical work healthy, from the people who do it.
        </p>
      </div>
    </section>

    <section class="blog-list-section" aria-labelledby="blog-list-heading">
      <div class="section-container">
        <h2 id="blog-list-heading" class="sr-only">
          All posts
        </h2>

        {posts.length === 0 ? (
          <div class="blog-empty">
            <p class="blog-empty-lead">No posts yet.</p>
            <p class="blog-empty-support">
              The first ones are on their way. Check back soon.
            </p>
          </div>
        ) : (
          <ul class="blog-list" role="list">
            {posts.map((post) => (
              <li class="blog-card">
                <article class="blog-card-inner">
                  {post.cover && (
                    <div class="blog-card-cover">
                      <img src={post.cover} alt="" loading="lazy" />
                    </div>
                  )}
                  <div class="blog-card-text">
                    {post.category && (
                      <p class="blog-card-category">{post.category}</p>
                    )}
                    {/* The title link stretches over the whole card, so the card is one
                        click target with one accessible name. */}
                    <h3 class="blog-card-title">
                      <a href={`/blog/${post.slug}`}>{post.title}</a>
                    </h3>
                    {post.excerpt && (
                      <p class="blog-card-excerpt">{post.excerpt}</p>
                    )}
                    <p class="blog-card-meta">
                      {post.author && (
                        <>
                          <span>By {findAuthor(post.author)?.name || post.author}</span>
                          <span aria-hidden="true">·</span>
                        </>
                      )}
                      {post.date && (
                        <>
                          <time datetime={post.date}>{formatDate(post.date)}</time>
                          <span aria-hidden="true">·</span>
                        </>
                      )}
                      <span>{post.readingMinutes} min read</span>
                    </p>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
