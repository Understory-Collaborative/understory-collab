---
// Phase 0 spike (docs/astro-migration-plan.md). It proves three things on the Vercel
// preview: an Astro page builds with the site's global CSS, a React island hydrates, and
// that island reaches an `api/` function. Phase 2 replaces this file with the real Home page.
import '../index.css'
import SubscribeForm from '../components/SubscribeForm.jsx'
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <title>Astro spike | Understory Collaborative</title>
  </head>
  <body>
    <main id="main-content" class="spike">
      <h1>Astro spike</h1>
      <p>
        This page is plain HTML built by Astro. If the fonts and colors match the live site, the
        design tokens and <code>src/index.css</code> load.
      </p>

      <h2>Island check</h2>
      <p>
        The form below is the footer's React <code>SubscribeForm</code>, mounted as an island.
        To check the <code>api/</code> function without adding anyone to the list, submit <code>test@localhost</code>.
        The browser accepts it, and <code>/api/subscribe</code> rejects it with a 400, so the form should say "Please check what you entered and try
        again."
      </p>
      <SubscribeForm client:visible heading="Newsletter" description="Spike copy of the footer form." />

      <h2>Function check</h2>
      <p>
        A missing function returns a 404, which the form reports with the same message as a 400.
        This check sends a GET to <code>/api/subscribe</code>, which the deployed function answers
        with a 405 and adds nothing to the list.
      </p>
      <p id="api-check" role="status">Checking <code>/api/subscribe</code>…</p>
    </main>
    <script>
      const out = document.getElementById('api-check')
      fetch('/api/subscribe')
        .then(async (res) => {
          const body = await res.json().catch(() => null)
          out.textContent =
            res.status === 405 && body?.error
              ? 'Pass: /api/subscribe is deployed and answered 405, as expected.'
              : `Fail: /api/subscribe answered ${res.status}, where 405 means deployed.`
        })
        .catch(() => {
          out.textContent = 'Fail: the request to /api/subscribe never got a reply.'
        })
    </script>
  </body>
</html>

<style>
  .spike {
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }
</style>
