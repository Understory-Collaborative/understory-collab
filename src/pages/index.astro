---
// Placeholder home page while the migration is under way (docs/astro-migration-plan.md).
// It shows the phase 1 shell: nav, footer, theme, and skip link. Phase 2 replaces this
// file with the real Home page.
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="Astro migration preview" noindex>
  <section class="page-hero">
    <div class="page-hero-content">
      <h1>Astro migration preview</h1>
      <p class="page-hero-description">
        This page stands in for Home while the site moves to Astro. The nav, footer, and theme
        toggle around it are the new shell. Pages that haven't moved yet show the 404 page.
      </p>
    </div>
  </section>
</BaseLayout>
