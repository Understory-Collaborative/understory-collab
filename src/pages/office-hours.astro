---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../views/OfficeHours.css'

// Zoom meeting registration: sign-ups are approved by hand, and each one answers a required
// question. Office hours went free on 2026-10-10 (HANDOFF D3).
const REGISTER_URL = 'https://us06web.zoom.us/meeting/register/UNoT1xY4QRmrZLNqtErjRw'
---
<BaseLayout
  title="Office hours"
  description="Thirty minutes with someone who's seen just about everything, for a problem you can't take to your team or your boss. Free, Tuesdays at 8:30 am Pacific."
>
  <div class="office-hours">
    <section class="page-hero" aria-labelledby="oh-heading">
      <div class="page-hero-content">
        <h1 id="oh-heading">Office hours</h1>
        <p class="page-hero-lead">
          There's a problem you can't take to your team or your boss. Bring it
          here.
        </p>
        <p class="page-hero-support">
          Thirty minutes with someone who's seen just about everything. Free,
          every Tuesday at 8:30 am Pacific.
        </p>
        <p class="oh-cta">
          <a
            class="btn btn-primary btn-large"
            href={REGISTER_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Save a seat
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
          <span class="oh-newtab" aria-hidden="true">Opens in a new tab</span>
        </p>
      </div>
    </section>

    <section class="oh-section" aria-labelledby="oh-who-heading">
      <div class="section-container">
        <h2 id="oh-who-heading">Who it's for</h2>
        <p>
          It's for a leader whose work depends on a technical team they can't
          always read, or who wants an outside opinion before committing to
          anything bigger. It's also for the person closest to the work who wants
          to get better at it, like a product owner or technical product manager
          learning the job as they go.
        </p>
      </div>
    </section>

    <section class="oh-section" aria-labelledby="oh-bring-heading">
      <div class="section-container">
        <h2 id="oh-bring-heading">What to bring</h2>
        <p>
          Bring the one question you most want answered. You'll write it down
          when you register, and it's what makes the time count. If you have a field
          guide, bring it marked up with what rang true and what you're still
          unsure about.
        </p>

        <table class="oh-glance">
          <caption class="sr-only">Office hours at a glance</caption>
          <tbody>
            <tr>
              <th scope="row">When</th>
              <td>Tuesdays, 8:30 to 9 am Pacific</td>
            </tr>
            <tr>
              <th scope="row">Format</th>
              <td>A small group on Zoom</td>
            </tr>
            <tr>
              <th scope="row">Price</th>
              <td>Free</td>
            </tr>
            <tr>
              <th scope="row">Bring</th>
              <td>One question, and your field guide if you have one</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="oh-section oh-fallback" aria-labelledby="oh-fallback-heading">
      <div class="section-container">
        <h2 id="oh-fallback-heading">Can't make Tuesdays?</h2>
        <p>
          Ask a question for free, and we'll answer it on the blog and on
          socials. <a href="/questions">Ask a question</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
