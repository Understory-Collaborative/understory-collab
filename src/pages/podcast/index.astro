---
// Between the Seams: every episode with a player, its notes, and its chapters. The same
// data builds the RSS feed at /podcast/feed.xml. Noindexed until the team launches it.
import BaseLayout from '../../layouts/BaseLayout.astro'
import { show, episodes, audioUrl, episodePath } from '../../data/podcastData.js'
import '../../views/Podcast.css'

const day = (iso) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Los_Angeles' })
const minutes = (seconds) => `${Math.round(seconds / 60)} minutes`
---
<BaseLayout
  title={show.title}
  description="A podcast from Understory Collaborative about where software projects get stuck, for leaders whose dates keep sliding and for TPMs who want to get better at the job."
  image={show.image}
  noindex
>
  <div class="podcast">
    <section class="page-hero" aria-labelledby="podcast-heading">
      <div class="page-hero-content podcast-hero">
        <img class="podcast-cover" src={show.image} alt="" width="240" height="240" />
        <div>
          <h1 id="podcast-heading">{show.title}</h1>
          {show.description.map((paragraph) => <p class="page-hero-support">{paragraph}</p>)}
          <p class="podcast-feed">
            To listen in a podcast app, add the feed: <a href="/podcast/feed.xml">understorycollab.com/podcast/feed.xml</a>
          </p>
        </div>
      </div>
    </section>

    <section class="podcast-episodes" aria-label="Episodes">
      <div class="section-container">
        {episodes.map((episode) => (
          <article class="podcast-episode" id={`episode-${episode.number}`} aria-labelledby={`episode-${episode.number}-title`}>
            <p class="podcast-meta">{`Episode ${episode.number} · ${day(episode.date)} · ${minutes(episode.seconds)}`}</p>
            <h2 id={`episode-${episode.number}-title`}><a href={episodePath(episode)}>{episode.title}</a></h2>
            <audio controls preload="none" src={audioUrl(episode)}>
              <a href={audioUrl(episode)}>Download the episode</a>
            </audio>
            <p>{episode.description}</p>
            <p>
              {episode.cta[0]} <a href={episode.cta[1]}>{episode.cta[1].replace('https://', '')}</a>
            </p>
            <p><a href={episodePath(episode)}>Watch, read the transcript, and jump to a chapter</a></p>
            <details>
              <summary>Chapters</summary>
              <ol class="podcast-chapters">
                {episode.chapters.map(([at, name]) => <li><span>{at}</span> {name}</li>)}
              </ol>
            </details>
          </article>
        ))}
        <p class="podcast-office-hours">
          Want to talk something through? <a href="/office-hours">Book free office hours</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
